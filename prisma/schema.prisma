generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model mst_currencies {
  id                                                                     Int                   @id(map: "currencies_pkey") @default(autoincrement())
  currency_code                                                          String                @unique(map: "currencies_currency_code_key") @db.VarChar(3)
  currency_name                                                          String                @db.VarChar(100)
  currency_symbol                                                        String                @db.VarChar(10)
  decimal_places                                                         Int                   @default(2) @db.SmallInt
  is_base_currency                                                       Boolean?              @default(false)
  created_at                                                             DateTime?             @default(now()) @db.Timestamptz(6)
  mst_currency_rates_mst_currency_rates_from_currency_idTomst_currencies mst_currency_rates[]  @relation("mst_currency_rates_from_currency_idTomst_currencies")
  mst_currency_rates_mst_currency_rates_to_currency_idTomst_currencies   mst_currency_rates[]  @relation("mst_currency_rates_to_currency_idTomst_currencies")
  txn_purchase_orders                                                    txn_purchase_orders[]
}

model mst_currency_rates {
  id                                                                 Int            @id(map: "currency_rates_pkey") @default(autoincrement())
  from_currency_id                                                   Int
  to_currency_id                                                     Int
  exchange_rate                                                      Decimal        @db.Decimal(18, 6)
  mst_currencies_mst_currency_rates_from_currency_idTomst_currencies mst_currencies @relation("mst_currency_rates_from_currency_idTomst_currencies", fields: [from_currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rate_from_currency")
  mst_currencies_mst_currency_rates_to_currency_idTomst_currencies   mst_currencies @relation("mst_currency_rates_to_currency_idTomst_currencies", fields: [to_currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rate_to_currency")
}

model mst_departments {
  id            Int             @id(map: "departments_pkey") @default(autoincrement())
  name          String          @unique(map: "departments_name_key") @db.VarChar(100)
  mst_employees mst_employees[]
  txn_indents   txn_indents[]
}

model mst_employees {
  id                                                    Int              @id(map: "employees_pkey") @default(autoincrement())
  employee_name                                         String           @db.VarChar(100)
  email                                                 String?          @unique(map: "employees_email_key") @db.VarChar(150)
  phone                                                 String?          @db.VarChar(20)
  designation                                           String?          @db.VarChar(100)
  department_id                                         Int?
  created_at                                            DateTime?        @default(now()) @db.Timestamptz(6)
  username                                              String?          @unique(map: "employees_username_key") @db.VarChar(50)
  password                                              String?          @db.VarChar(255)
  role_id                                               Int?
  area_id                                               Int?
  mst_departments                                       mst_departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "employees_department_id_fkey")
  mst_area                                              mst_area?        @relation(fields: [area_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_area")
  mst_user_roles                                        mst_user_roles?  @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_role")
  txn_indents_txn_indents_l1_approved_byTomst_employees txn_indents[]    @relation("txn_indents_l1_approved_byTomst_employees")
  txn_indents_txn_indents_l2_approved_byTomst_employees txn_indents[]    @relation("txn_indents_l2_approved_byTomst_employees")
  txn_indents_txn_indents_requested_byTomst_employees   txn_indents[]    @relation("txn_indents_requested_byTomst_employees")
}

model mst_indent_statuses {
  id          Int           @id(map: "indent_statuses_pkey") @default(autoincrement())
  code        String        @unique(map: "indent_statuses_code_key") @db.VarChar(30)
  description String        @db.VarChar(50)
  codeId      Int
  txn_indents txn_indents[]
}

model mst_inventory_control_thresholds {
  id               Int           @id(map: "inventory_control_thresholds_pkey") @default(autoincrement())
  material_code_id Int
  minimum_level    Int?
  maximum_level    Int?
  threshold        Int?
  mst_materials    mst_materials @relation(fields: [material_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_materials")
}

model mst_material_categories {
  id            Int             @id(map: "material_categories_pkey") @default(autoincrement())
  name          String          @unique(map: "material_categories_name_key") @db.VarChar(100)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  code          String          @db.VarChar(100)
  mst_materials mst_materials[]
}

model mst_materials {
  id                               Int                                @id(map: "materials_pkey") @default(autoincrement())
  code                             String                             @unique(map: "materials_code_key") @db.VarChar(50)
  description                      String                             @db.VarChar(500)
  category_id                      Int
  created_at                       DateTime?                          @default(now()) @db.Timestamptz(6)
  mst_inventory_control_thresholds mst_inventory_control_thresholds[]
  mst_material_categories          mst_material_categories            @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_material_category")
  mst_vendor_materials             mst_vendor_materials[]
  txn_approved_indent_materials    txn_approved_indent_materials[]
  txn_indent_items                 txn_indent_items[]
  txn_purchase_order_items         txn_purchase_order_items[]
  txn_stock_summary                txn_stock_summary[]
}

model mst_tax_codes {
  id                Int                 @id(map: "tax_codes_pkey") @default(autoincrement())
  hsn_codes         String              @unique(map: "tax_codes_hsn_codes_key") @db.VarChar(100)
  gst_rate          Decimal             @db.Decimal(5, 2)
  txn_stock_summary txn_stock_summary[]
}

model mst_uoms {
  id                Int                 @id(map: "uoms_pkey") @default(autoincrement())
  code              String              @unique(map: "uoms_code_key") @db.VarChar(20)
  name              String              @db.VarChar(100)
  txn_stock_summary txn_stock_summary[]
}

model mst_user_roles {
  id            Int             @id(map: "user_roles_pkey") @default(autoincrement())
  role_name     String          @unique(map: "user_roles_role_name_key") @db.VarChar(50)
  description   String          @db.VarChar(100)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  mst_employees mst_employees[]
}

model mst_vendor_materials {
  id            Int           @id(map: "vendor_materials_pkey") @default(autoincrement())
  vendor_id     Int
  material_id   Int
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  mst_materials mst_materials @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vm_material")
  mst_vendors   mst_vendors   @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vm_vendor")
}

model mst_vendors {
  id                   Int                    @id(map: "vendors_pkey") @default(autoincrement())
  company_name         String                 @db.VarChar(200)
  company_address      String
  contact_person       String                 @db.VarChar(100)
  contact_phone        String                 @db.VarChar(20)
  email                String                 @db.VarChar(150)
  pan                  String                 @db.VarChar(10)
  tan                  String?                @db.VarChar(10)
  bank_name            String                 @db.VarChar(150)
  bank_account_no      String                 @db.VarChar(50)
  bank_branch_address  String?
  ifsc_code            String                 @db.VarChar(11)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @db.Timestamptz(6)
  mst_vendor_materials mst_vendor_materials[]
  txn_purchase_orders  txn_purchase_orders[]
}

model txn_indent_items {
  id                Int           @id(map: "indent_items_pkey") @default(autoincrement())
  indent_id         Int
  material_id       Int
  quantity          Decimal       @db.Decimal(14, 3)
  unit_price        Decimal       @db.Decimal(14, 2)
  material_code     String        @db.VarChar(50)
  description       String        @db.VarChar(500)
  uom               String        @db.VarChar(20)
  gst_rate          Decimal       @db.Decimal(5, 2)
  is_l1_approved    Boolean?      @default(false)
  is_l2_approved    Boolean?      @default(false)
  is_rejected       Boolean?      @default(false)
  rejection_reason  String?       @db.VarChar(500)
  issued_quantity   Decimal?      @db.Decimal(14, 3)
  is_issue_rejected Boolean?      @default(false)
  txn_indents       txn_indents   @relation(fields: [indent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_indent_item_indent")
  mst_materials     mst_materials @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_indent_item_material")
}

model txn_indents {
  id                                                      Int                             @id(map: "indents_pkey") @default(autoincrement())
  indent_no                                               String                          @unique(map: "indents_indent_no_key") @db.VarChar(30)
  department_id                                           Int
  requested_by                                            Int
  total_value                                             Decimal                         @db.Decimal(14, 2)
  l1_approved                                             Boolean?                        @default(false)
  l2_approved                                             Boolean?                        @default(false)
  rejection_reason                                        String?                         @db.VarChar(200)
  created_at                                              DateTime?                       @default(now()) @db.Timestamptz(6)
  updated_at                                              DateTime?                       @db.Timestamptz(6)
  l1_approved_by                                          Int?
  l1_approved_at                                          DateTime?                       @db.Timestamptz(6)
  l2_approved_by                                          Int?
  l2_approved_at                                          DateTime?                       @db.Timestamptz(6)
  status_id                                               Int?
  l1_approval_required                                    Boolean?
  l2_approval_required                                    Boolean?
  area_id                                                 Int
  is_material_issue                                       Boolean                         @default(false)
  is_draft                                                Boolean                         @default(false)
  is_l1_partially_approved                                Boolean?                        @default(false)
  is_l2_partially_approved                                Boolean?                        @default(false)
  txn_approved_indent_materials                           txn_approved_indent_materials[]
  txn_indent_items                                        txn_indent_items[]
  mst_area                                                mst_area                        @relation(fields: [area_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_indent_area")
  mst_departments                                         mst_departments                 @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_indent_department")
  mst_indent_statuses                                     mst_indent_statuses?            @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_indent_status")
  mst_employees_txn_indents_l1_approved_byTomst_employees mst_employees?                  @relation("txn_indents_l1_approved_byTomst_employees", fields: [l1_approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_indents_l1_approved_by")
  mst_employees_txn_indents_l2_approved_byTomst_employees mst_employees?                  @relation("txn_indents_l2_approved_byTomst_employees", fields: [l2_approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_indents_l2_approved_by")
  mst_employees_txn_indents_requested_byTomst_employees   mst_employees                   @relation("txn_indents_requested_byTomst_employees", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_indents_requested_by")
}

model txn_purchase_order_items {
  id                  Int                 @id(map: "purchase_order_items_pkey") @default(autoincrement())
  po_id               Int
  material_id         Int
  material_code       String              @db.VarChar(50)
  description         String              @db.VarChar(500)
  qty                 Decimal             @db.Decimal(14, 3)
  unit_price          Decimal             @db.Decimal(14, 2)
  uom                 String              @db.VarChar(20)
  gst_rate            Decimal             @db.Decimal(5, 2)
  is_l1_approved      Boolean?            @default(false)
  is_l2_approved      Boolean?            @default(false)
  is_rejected         Boolean?            @default(false)
  rejection_reason    String?             @db.VarChar(500)
  is_completed        Boolean?            @default(false)
  txn_grn_items       txn_grn_items[]
  mst_materials       mst_materials       @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_order_items_material_id_fkey")
  txn_purchase_orders txn_purchase_orders @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_order_items_po_id_fkey")
}

model txn_purchase_orders {
  id                        Int                        @id(map: "purchase_orders_pkey") @default(autoincrement())
  po_no                     String                     @unique(map: "purchase_orders_po_no_key") @db.VarChar(30)
  vendor_id                 Int
  version                   Int?                       @default(1)
  subtotal                  Decimal                    @db.Decimal(14, 4)
  gst_amount                Decimal?                   @db.Decimal(14, 4)
  total_amount              Decimal                    @db.Decimal(14, 4)
  issued_date               DateTime?                  @db.Timestamptz(6)
  created_at                DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                  @db.Timestamptz(6)
  currency_id               Int?
  exchange_rate             Decimal?                   @db.Decimal(18, 4)
  base_currency_amount      Decimal?                   @db.Decimal(14, 4)
  freight                   Decimal?                   @db.Decimal(14, 4)
  packing                   Decimal?                   @db.Decimal(14, 4)
  other_charges             Decimal?                   @db.Decimal(14, 4)
  remarks                   String?                    @db.VarChar(200)
  payment_terms             String?                    @db.VarChar(30)
  shipping_address          String?                    @db.VarChar(200)
  expected_delivery         DateTime?                  @db.Timestamptz(6)
  type                      Int?
  billing_address           String?                    @db.VarChar(200)
  l1_approval_required      Boolean?
  l2_approval_required      Boolean?
  l1_approved               Boolean?
  l1_approved_at            DateTime?                  @db.Timestamptz(6)
  l2_approved               Boolean?
  l2_approved_at            Boolean?
  status_id                 Int?
  txn_purchase_order_items  txn_purchase_order_items[]
  txn_purchase_order_terms  txn_purchase_order_terms[]
  mst_purchase_order_status mst_purchase_order_status? @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_order_status")
  mst_currencies            mst_currencies?            @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_orders_currency_id_fkey")
  mst_vendors               mst_vendors                @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_orders_vendor_id_fkey")
}

model txn_stock_summary {
  id            Int            @id(map: "stock_summary_pkey") @default(autoincrement())
  material_id   Int?
  bin_location  String?        @db.VarChar(50)
  stock_qty     Float?         @default(0) @db.Real
  tax_code_id   Int?
  uom_id        Int?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?      @db.Timestamptz(6)
  mst_materials mst_materials? @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stock_materials")
  mst_tax_codes mst_tax_codes? @relation(fields: [tax_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stock_tax_code")
  mst_uoms      mst_uoms?      @relation(fields: [uom_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stock_uom")
}

model mst_area {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  mst_employees mst_employees[]
  txn_indents   txn_indents[]
}

model mst_system_parameters {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String  @db.VarChar(200)
  uom         String? @db.VarChar(20)
  type        Int?
  value       String? @db.VarChar
  datatype    String? @db.VarChar
}

model txn_approved_indent_materials {
  id                    Int           @id @default(autoincrement())
  material_id           Int
  indent_id             Int
  quantity              Decimal       @db.Decimal(12, 2)
  price                 Decimal       @db.Decimal(12, 2)
  approved_date         DateTime      @default(now()) @db.Timestamp(6)
  is_received           Boolean       @default(false)
  is_partially_received Boolean       @default(false)
  received_quantity     Decimal       @default(0) @db.Decimal(12, 2)
  po_id                 Int?
  po_no                 String?       @db.VarChar(30)
  txn_indents           txn_indents   @relation(fields: [indent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_approved_indent_materials_indent")
  mst_materials         mst_materials @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_approved_indent_materials_material")
}

model txn_approval_rules {
  id         BigInt    @id @default(autoincrement())
  module     String    @db.VarChar(100)
  rule_name  String    @db.VarChar(255)
  priority   Int       @default(1)
  enabled    Boolean   @default(true)
  conditions Json
  actions    Json
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model mst_purchase_order_status {
  id                  Int                   @id @default(autoincrement())
  code_id             Int?
  code                String                @db.VarChar(200)
  description         String                @db.VarChar(200)
  txn_purchase_orders txn_purchase_orders[]
}

model mst_company_settings {
  id           Int       @id @default(autoincrement())
  company_name String?   @db.VarChar(255)
  address      String?
  phone        String?   @db.VarChar(50)
  email        String?   @db.VarChar(255)
  gst_number   String?   @db.VarChar(50)
  logo_path    String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
}

model mst_po_terms {
  id                       Int                        @id @default(autoincrement())
  title                    String                     @db.VarChar(255)
  content                  String
  display_order            Int?                       @default(0)
  enabled                  Boolean?                   @default(true)
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                  @default(now()) @db.Timestamp(6)
  txn_purchase_order_terms txn_purchase_order_terms[]
}

model txn_purchase_order_terms {
  id                  Int                 @id @default(autoincrement())
  po_id               Int
  term_title          String?             @db.VarChar(255)
  term_context        String
  display_order       Int
  created_at          DateTime?           @default(now()) @db.Timestamp(6)
  term_id             Int?
  txn_purchase_orders txn_purchase_orders @relation(fields: [po_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_terms_po")
  mst_po_terms        mst_po_terms?       @relation(fields: [term_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_terms_po_terms")
}

model txn_grn_attachments {
  id            BigInt    @id @default(autoincrement())
  grn_id        BigInt
  document_type String    @db.VarChar(50)
  file_name     String    @db.VarChar(255)
  file_path     String
  file_size     BigInt?
  mime_type     String?   @db.VarChar(100)
  uploaded_by   BigInt?
  uploaded_at   DateTime? @default(now()) @db.Timestamp(6)
  txn_grns      txn_grns  @relation(fields: [grn_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grn_attachment_grn")
}

model txn_grn_items {
  id                           BigInt                   @id @default(autoincrement())
  grn_id                       BigInt
  po_item_id                   Int
  po_quantity                  Decimal                  @default(0) @db.Decimal(18, 3)
  previously_received_quantity Decimal                  @default(0) @db.Decimal(18, 3)
  gate_received_quantity       Decimal                  @default(0) @db.Decimal(18, 3)
  confirmed_quantity           Decimal                  @default(0) @db.Decimal(18, 3)
  accepted_quantity            Decimal                  @default(0) @db.Decimal(18, 3)
  rejected_quantity            Decimal                  @default(0) @db.Decimal(18, 3)
  unit                         String?                  @db.VarChar(30)
  batch_no                     String?                  @db.VarChar(100)
  serial_no                    String?                  @db.VarChar(100)
  storage_location_id          BigInt?
  remarks                      String?
  created_at                   DateTime?                @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?                @default(now()) @db.Timestamp(6)
  txn_grns                     txn_grns                 @relation(fields: [grn_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grn_items_grn")
  txn_purchase_order_items     txn_purchase_order_items @relation(fields: [po_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_grn_items_po_items")
}

model txn_grns {
  id                    BigInt                @id @default(autoincrement())
  grn_number            String                @unique @db.VarChar(50)
  po_id                 BigInt
  vendor_id             BigInt
  gate_entry_date       DateTime              @default(now()) @db.Timestamp(6)
  vehicle_no            String?               @db.VarChar(50)
  driver_name           String?               @db.VarChar(150)
  gate_received_by      BigInt?
  invoice_no            String?               @db.VarChar(100)
  invoice_date          DateTime?             @db.Date
  invoice_amount        Decimal?              @db.Decimal(18, 2)
  taxable_amount        Decimal?              @db.Decimal(18, 2)
  gst_amount            Decimal?              @db.Decimal(18, 2)
  eway_bill_no          String?               @db.VarChar(100)
  invoice_confirmed_by  BigInt?
  invoice_confirmed_at  DateTime?             @db.Timestamp(6)
  status_id             Int?
  remarks               String?
  created_by            BigInt?
  created_at            DateTime              @default(now()) @db.Timestamp(6)
  updated_by            BigInt?
  updated_at            DateTime              @default(now()) @db.Timestamp(6)
  type                  Int?
  is_phase_two_required Boolean?
  txn_grn_attachments   txn_grn_attachments[]
  txn_grn_items         txn_grn_items[]
  mst_grns_status       mst_grns_status?      @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_grns_status")
}

model mst_grns_status {
  id          Int        @id @default(autoincrement())
  code_id     Int?
  code        String     @unique @db.VarChar(200)
  description String     @unique @db.VarChar(200)
  txn_grns    txn_grns[]
}
